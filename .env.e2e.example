# E2E-Testkonfiguration für Mercator Playwright-Tests
# Kopiere diese Datei nach .env.e2e und passe die Werte an.
#
# Verwendung:
#   $env:MERCATOR_E2E_BASE_URL = "http://localhost:8501"
#   pytest tests/e2e/ -v
#
# Oder via Datei:
#   copy .env.e2e.example .env.e2e
#   pytest tests/e2e/ -v
#
# Die Datei .env.e2e wird von tests/e2e/conftest.py automatisch geladen.

# ─── App-URL ───────────────────────────────────────────────────────────────
# Standard: http://localhost:8501 (lokale Streamlit-App)
MERCATOR_E2E_BASE_URL=http://localhost:8501

# ─── Browser-Modus ─────────────────────────────────────────────────────────
# headless=true: kein sichtbares Browser-Fenster (für CI empfohlen)
# headless=false: sichtbares Fenster (für lokales Debugging)
MERCATOR_E2E_HEADLESS=true

# ─── Timeouts (Millisekunden) ──────────────────────────────────────────────
MERCATOR_E2E_PAGE_LOAD_TIMEOUT_MS=30000
MERCATOR_E2E_ACTION_TIMEOUT_MS=15000
MERCATOR_E2E_STREAMLIT_READY_TIMEOUT_MS=20000

# ─── Slow Motion (ms zwischen Aktionen) ───────────────────────────────────
# 0 = keine Verzögerung (schnellstmöglich)
# 500 = halbe Sekunde zwischen Aktionen (Debugging)
MERCATOR_E2E_SLOW_MO=0

