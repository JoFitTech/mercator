#!/bin/bash
# Mercator Control Script (Bash-Wrapper für mercator.ps1)
# Verwendung: ./mercator start|stop|restart|share-start|share-stop|share-reset
#
# Hinweis für Windows Benutzer:
# - Im normalen Windows Terminal: verwende "mercator.bat start" oder ".\mercator.ps1 start"
# - In WSL/Git Bash: dieses Skript funktioniert auch
# - Auf Linux/macOS: dieses Skript ist die Standard-Methode

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PS1_SCRIPT="$SCRIPT_DIR/mercator.ps1"
BAT_SCRIPT="$SCRIPT_DIR/mercator.bat"

# Standardaktion ist "start"
ACTION="${1:-start}"
SERVICE="${2:-app}"

# Erkenne das aktuelle System
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "win32" ]]; then
    # Windows (Git Bash / MSYS)
    # Versuche PowerShell zu finden
    if command -v pwsh &> /dev/null; then
        PS_CMD="pwsh"
    elif command -v powershell &> /dev/null; then
        PS_CMD="powershell"
    else
        echo "Fehler: PowerShell nicht gefunden."
        echo ""
        echo "Mögliche Lösungen:"
        echo "  1. Verwende stattdessen das Batch-Skript:"
        echo "     mercator.bat $ACTION"
        echo ""
        echo "  2. Oder das PowerShell-Skript direkt:"
        echo "     .\mercator.ps1 -Action $ACTION"
        echo ""
        echo "  3. Oder aktiviere PowerShell in deinem Terminal (Standard ab Windows 11)"
        exit 1
    fi

    # Führe PowerShell-Skript aus
    "$PS_CMD" -NoProfile -File "$PS1_SCRIPT" -Action "$ACTION" -Service "$SERVICE"

elif [[ "$OSTYPE" == "linux-gnu" || "$OSTYPE" == "darwin"* ]]; then
    # Linux oder macOS
    # Primär: native Docker-Compose-Befehle.
    # Fallback: PowerShell (wenn installiert), damit Verhalten konsistent bleibt.
    COMPOSE_FILE="$SCRIPT_DIR/mercator-compose.yml"

    run_compose() {
        docker compose -f "$COMPOSE_FILE" "$@"
    }

    ensure_compose() {
        if ! command -v docker >/dev/null 2>&1; then
            echo "Fehler: Docker wurde nicht gefunden."
            exit 1
        fi
    }

    get_app_url() {
        local ports
        ports="$(docker ps --filter "name=^/mercator-app$" --format "{{.Ports}}" 2>/dev/null || true)"
        if [[ "$ports" =~ 127\.0\.0\.1:([0-9]+)-> ]]; then
            echo "http://localhost:${BASH_REMATCH[1]}"
        else
            echo "http://localhost:8501"
        fi
    }

    open_url() {
        local url="$1"
        if command -v xdg-open >/dev/null 2>&1; then
            xdg-open "$url" >/dev/null 2>&1 || true
        elif command -v open >/dev/null 2>&1; then
            open "$url" >/dev/null 2>&1 || true
        else
            echo "Hinweis: Bitte Browser manuell öffnen: $url"
        fi
    }

    if command -v pwsh &> /dev/null; then
        pwsh -NoProfile -File "$PS1_SCRIPT" -Action "$ACTION" -Service "$SERVICE"
    else
        ensure_compose
        case "$ACTION" in
            start)
                # WICHTIG: --build stellt sicher, dass Dockerfile-Aenderungen (z.B. cloudflared) geladen werden
                run_compose up -d --build --wait
                echo "Mercator gestartet. App: $(get_app_url)"
                ;;
            stop)
                run_compose down
                echo "Mercator gestoppt."
                ;;
            restart)
                run_compose down
                # WICHTIG: --build wird verwendet um sicherzustellen, dass Dockerfile-Aenderungen geladen werden
                run_compose up -d --build --wait
                echo "Mercator neu gestartet. App: $(get_app_url)"
                ;;
            *)
                echo "Fehler: Unbekannte Aktion: $ACTION"
                echo "Erlaubte Aktionen: start | stop | restart"
                exit 1
                ;;
        esac
    fi
else
    # Unbekanntes System
    echo "Fehler: Unbekanntes Betriebssystem: $OSTYPE"
    echo "Dieses Skript wird auf Linux, macOS und Windows (Git Bash) unterstützt."
    exit 1
fi
