# Bash/Shell scripts - Unix line endings
mercator text eol=lf
*.sh text eol=lf

# Windows scripts
mercator.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# PowerShell modules
*.psm1 text eol=crlf

# Python
*.py text eol=lf

# JSON/YAML/TOML
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

