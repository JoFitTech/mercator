flowchart LR
    subgraph Q[Oeffentliche Datenquelle]
        API1[FMP API<br/>Latest Insider Trades]
        APIX[FMP API<br/>selektive Profil- und Marktdatenanreicherung]
    end

    subgraph V[Python/Pandas Pipeline]
        IMP[Import und Normalisierung]
        VAL[Validierung]
        GATE[Gate-Logik]
        ENR[Enrichment]
        SCORE[Scoring und Klassifikation]
    end

    subgraph P[Persistenz]
        MONGO[MongoDB<br/>Raw-Store]
        MYSQL[MySQL<br/>Clean-Store]
    end

    subgraph U[Streamlit-Oberflaeche]
        DASH[Dashboard]
        EXP[Trade-Explorer]
        DET[Detailansichten]
    end

    API1 --> IMP
    IMP --> MONGO
    IMP --> VAL --> GATE
    GATE -. qualifizierte Faelle .-> APIX
    APIX --> ENR
    GATE --> SCORE
    ENR --> SCORE
    SCORE --> MYSQL

    MONGO -. Rohdaten und Profile .-> DASH
    MYSQL --> DASH
    MYSQL --> EXP
    MYSQL --> DET
