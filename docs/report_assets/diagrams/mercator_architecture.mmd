flowchart LR
    subgraph Q[Oeffentliche Datenquelle]
        API1[FMP API<br/>Latest Insider Trades]
        API2[FMP API optional<br/>Company Profile und Marktdaten]
    end

    subgraph V[Python/Pandas Pipeline]
        IMP[Import]
        VAL[Validierung]
        GATE[Gate-Logik]
        ENR[Enrichment]
        SCORE[Scoring A-E]
    end

    subgraph P[Persistenzschicht]
        MONGO[MongoDB<br/>Raw-Store]
        MYSQL[MySQL<br/>Clean-Store]
    end

    subgraph U[Streamlit UI]
        DASH[Dashboard]
        EXP[Trade-Explorer]
        DET[Detailansichten]
    end

    API1 --> IMP --> VAL --> GATE --> ENR
    IMP --> MONGO
    GATE -. qualifizierte Faelle .-> API2
    API2 --> ENR
    ENR --> SCORE --> MYSQL
    MYSQL --> DASH
    MYSQL --> EXP
    MYSQL --> DET
    MONGO -.-> DASH
