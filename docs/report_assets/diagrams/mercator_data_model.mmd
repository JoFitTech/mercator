erDiagram
    COMPANIES {
        string company_key PK
        string current_symbol
        string company_name
        string profile_status
        string sector
        bigint market_cap
        datetime created_at
        datetime updated_at
    }

    INSIDER_TRADES {
        bigint id PK
        string company_key FK
        string symbol_at_trade
        string reporting_name
        date transaction_date
        decimal trade_value
        string validation_status
        string gate_status
        decimal score
        string score_class
        string dedupe_key
        datetime fetched_at
        datetime created_at
        datetime updated_at
