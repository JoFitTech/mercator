    }

    INSIDER_TRADES_RAW {
        string dedupe_key
        string symbol
        string reporting_name
        date transaction_date
        decimal trade_value_estimated
        string gate_status
        string profile_status
        json raw_payload
        datetime fetched_at
    }

    MONGO_COMPANIES {
        string company_key
        string current_symbol
        string profile_status
        datetime profile_updated_at
    }

    COMPANIES ||--o{ INSIDER_TRADES : company_key_fk
    COMPANIES ||--|| COMPANY_TRADE_STATS : company_key_fk

    INSIDER_TRADES }o--|| MARKET_SIGNAL_CACHE : logische_beziehung_symbol
