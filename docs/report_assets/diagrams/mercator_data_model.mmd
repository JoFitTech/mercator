    COMPANY_TRADE_STATS {
        string company_key PK
        bigint trade_count
        bigint buy_count
        bigint sell_count
        date last_trade_date
        datetime updated_at
    }

    MARKET_SIGNAL_CACHE {
        string symbol PK
        date lookback_from
        date lookback_to
        decimal avg_20d_volume
        decimal avg_20d_dollar_volume
        decimal sma_50
        decimal sma_200
        decimal momentum_3m
        decimal momentum_6m
        string technical_state
