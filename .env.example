# Active MySQL target selection
MYSQL_ACTIVE_TARGET=local
MYSQL_AUTO_FALLBACK_TO_LOCAL=true
MYSQL_SYNC_ENABLED=true

# Local MySQL target (native run: localhost, Docker-Compose overrides host to service name mysql)
LOCAL_MYSQL_HOST=localhost
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=finanzport_local
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=change_me
LOCAL_MYSQL_CONNECT_TIMEOUT=10
LOCAL_MYSQL_CREATE_DATABASE=false
LOCAL_MYSQL_SSL_DISABLED=true
LOCAL_MYSQL_SSL_CA=
LOCAL_MYSQL_SSL_CERT=
LOCAL_MYSQL_SSL_KEY=

# University MySQL target (usually only reachable in university network)
UNI_MYSQL_HOST=
UNI_MYSQL_PORT=3306
UNI_MYSQL_DATABASE=
UNI_MYSQL_USER=
UNI_MYSQL_PASSWORD=
UNI_MYSQL_CONNECT_TIMEOUT=5
UNI_MYSQL_CREATE_DATABASE=false
UNI_MYSQL_SSL_DISABLED=true
UNI_MYSQL_SSL_CA=
UNI_MYSQL_SSL_CERT=
UNI_MYSQL_SSL_KEY=

# Legacy single-target MySQL variables (compatibility fallback for local target)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=finanzport_local
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_CONNECT_TIMEOUT=10
MYSQL_CREATE_DATABASE=false
MYSQL_SSL_DISABLED=true
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=finanzport

GATE_MIN_TRADE_VALUE=10000
GATE_REQUIRE_PURCHASE_EVENT=true
GATE_REQUIRE_COMMON_STOCK=true
PROFILE_GATE_FILTER_STATUSES=PASS

FMP_API_KEY=change_me
APP_ENV=local
APP_TITLE=FinanzPort Academic
DATASET_PATH=data/raw/
