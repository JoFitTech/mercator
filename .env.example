# Active MySQL target selection
MYSQL_ACTIVE_TARGET=local
MYSQL_AUTO_FALLBACK_TO_LOCAL=true
MYSQL_SYNC_ENABLED=true
MYSQL_STARTUP_SYNC_ENABLED=true
MYSQL_STARTUP_SYNC_STALE_MINUTES=15

# Local MySQL target (native run: localhost, Docker-Compose overrides host to service name mysql)
LOCAL_MYSQL_HOST=localhost
LOCAL_MYSQL_PORT=3306
LOCAL_MYSQL_DATABASE=mercator_local
LOCAL_MYSQL_USER=root
LOCAL_MYSQL_PASSWORD=change_me
LOCAL_MYSQL_CONNECT_TIMEOUT=10
LOCAL_MYSQL_CREATE_DATABASE=false
LOCAL_MYSQL_SSL_DISABLED=true
LOCAL_MYSQL_SSL_CA=
LOCAL_MYSQL_SSL_CERT=
LOCAL_MYSQL_SSL_KEY=

# University MySQL target (usually only reachable in university network)
UNI_MYSQL_HOST=
UNI_MYSQL_PORT=3306
UNI_MYSQL_DATABASE=
UNI_MYSQL_USER=
UNI_MYSQL_PASSWORD=
UNI_MYSQL_CONNECT_TIMEOUT=5
UNI_MYSQL_CREATE_DATABASE=false
UNI_MYSQL_SSL_DISABLED=false
UNI_MYSQL_SSL_CA=
UNI_MYSQL_SSL_CERT=
UNI_MYSQL_SSL_KEY=

# Legacy single-target MySQL variables (compatibility fallback for local target)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mercator_local
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_CONNECT_TIMEOUT=10
MYSQL_CREATE_DATABASE=false
MYSQL_SSL_DISABLED=true
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=

MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=mercator

# Multi-target Mongo selection (optional; LOCAL_* is used when MONGO_ACTIVE_TARGET=local)
MONGO_ACTIVE_TARGET=local
MONGO_AUTO_FALLBACK_TO_LOCAL=true
LOCAL_MONGO_URI=mongodb://localhost:27017/
LOCAL_MONGO_DATABASE=mercator
# Uni Mongo: Ziel-DB wird separat über UNI_MONGO_DATABASE gesetzt (URI ohne DB-Pfad ist empfohlen).
# authSource=admin ist nur die Authentifizierungsdatenbank, nicht die Zieldatenbank.
# Wichtiger Hinweis: reservierte Zeichen im Passwort (z.B. @, :, /, ?) müssen URL-encoded sein.
UNI_MONGO_URI=mongodb://uni_user:Str0ng%40Pass%3Aword@mongo.uni.example:27017/?authSource=admin
UNI_MONGO_DATABASE=uni
# Fallback gilt nur von uni -> local, wenn UNI nicht erreichbar ist.

GATE_MIN_TRADE_VALUE=100000
GATE_REQUIRE_PURCHASE_EVENT=true
GATE_REQUIRE_COMMON_STOCK=true
GATE_ALLOWED_ACQ_DISP=A
GATE_ALLOWED_TRANSACTION_TYPES=
PROFILE_GATE_FILTER_STATUSES=PASS
PROFILE_LOOKUP_MODE=cik_primary_symbol_fallback

FMP_API_KEY=change_me
APP_ENV=local
APP_TITLE=Mercator
DATASET_PATH=data/raw/

# Review/UI test mode flags (read-only deployment)
MERCATOR_REVIEW_MODE=false
MERCATOR_DISABLE_IMPORT=false
MERCATOR_DISABLE_ADMIN_DELETE=false
MERCATOR_UI_TEST_MODE=false

# Trade Republic static reference universe
TRADE_REPUBLIC_UNIVERSE_LOCAL_CSV=data/reference/trade_republic/trade_republic_stocks.csv
TRADE_REPUBLIC_REFRESH_TTL_HOURS=168

# Public Share Configuration (Cloudflare Quick Tunnel)
# Aktiviert temporäre öffentliche Freigaben der App über Cloudflare Tunnel.
# host = empfohlen für lokale Windows-/Docker-/restriktive Netz-Setups
# container = bisheriger Fallback, cloudflared läuft im App-Container
ENABLE_PUBLIC_SHARE=false
PUBLIC_SHARE_PROVIDER=cloudflare
PUBLIC_SHARE_EXECUTION_MODE=host
PUBLIC_SHARE_LOCAL_URL=http://localhost:8501
CLOUDFLARED_BIN=cloudflared
PUBLIC_SHARE_STARTUP_TIMEOUT_SECONDS=20
PUBLIC_SHARE_STARTUP_GRACE_SECONDS=15
PUBLIC_SHARE_HEALTHCHECK_TIMEOUT_SECONDS=2.0
PUBLIC_SHARE_CLOUDFLARED_EXTRA_ARGS=
PUBLIC_SHARE_STATUS_FILE=.mercator/public-share/status.json
PUBLIC_SHARE_LOG_FILE=.mercator/public-share/cloudflared.log
PUBLIC_SHARE_PID_FILE=.mercator/public-share/pid.txt
